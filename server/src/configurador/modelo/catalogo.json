        { "id": "blanco", "nombre": "Blanco", "hex": "#F4F5F2" },
        { "id": "negro", "nombre": "Negro", "hex": "#1E1F21" },
        { "id": "gris", "nombre": "Gris", "hex": "#8A8F94" },
