{
  "version": 1,
  "provisorio": [
    "paletas.prepintada: los hex son aproximados, falta la carta de colores real"
  ],
  "medidas": { "altoTotal": 1250, "altoMesada": 900, "profundidad": 1100 },
  "linea": {
    "maxBateas": 3,
    "anguloEsquina": 90,
    "esquina": { "ancho": 1100, "fondo": 1100 },
    "mostradorRemate": { "ancho": 1100, "fondo": 1100, "alto": 900, "terminacion": "linea" }
  },
  "opcionesLinea": [
    { "id": "material", "tipo": "select", "default": "galvanizada_pintada",
      "valores": ["galvanizada_pintada", "galvanizada_prepintada", "inox"] },
    { "id": "color", "tipo": "color",
      "paletaSegun": { "galvanizada_pintada": "epoxi", "galvanizada_prepintada": "prepintada", "inox": null },
      "motivoSinPaleta": "El acero inoxidable no se pinta." },
    { "id": "lateral", "tipo": "select", "default": "recto", "valores": ["recto", "curvo"] },
    { "id": "producto", "tipo": "select", "default": "fiambres_lacteos", "valores": ["fiambres_lacteos", "carnes"] },
    { "id": "equipamiento", "tipo": "select", "default": "equipada", "valores": ["semi", "equipada"] },
    { "id": "ubicacionEquipo", "tipo": "select", "default": "incorporado",
      "valores": ["incorporado", "remoto"], "soloSi": { "equipamiento": "equipada" },
      "motivo": "La ubicación del equipo solo se elige si la batea es equipada." },
    { "id": "frio", "tipo": "select", "default": "forzado", "valores": ["estatico", "forzado"] },
    { "id": "bandeja", "tipo": "select", "default": "prepintada",
      "valores": ["prepintada", "inox"], "soloSi": { "frio": "forzado" },
      "motivo": "Las bandejas solo van con frío por aire forzado." },
    { "id": "rejillaSobreBandeja", "tipo": "select", "default": "ninguna",
      "valores": ["ninguna", "recta", "escalonada"], "soloSi": { "frio": "forzado" },
      "motivo": "La rejilla sobre bandeja solo va con frío por aire forzado." }
  ],
  "modulos": {
    "batea": [
      { "id": "largo", "tipo": "select", "default": 2000, "valores": [1200, 1500, 2000, 2400, 3000, 3600] },
      { "id": "cupula", "tipo": "select", "default": "cupula_curva",
        "valores": ["sin_cupula", "sin_cupula_iluminacion", "cupula_curva", "cupula_recta"] },
      { "id": "deposito", "tipo": "bool", "default": false },
      { "id": "puertasTraseras", "tipo": "bool", "default": false,
        "soloSi": { "cupula": ["cupula_curva", "cupula_recta"] },
        "motivo": "Las puertas traseras de acrílico solo van en bateas con cúpula (curva o recta)." }
    ],
    "esquina": [
      { "id": "forma", "tipo": "select", "default": "esquinero", "valores": ["esquinero", "rinconero"] },
      { "id": "version", "tipo": "select", "default": "frio", "valores": ["mostrador", "frio"] },
      { "id": "cupula", "tipo": "select", "default": "cupula_curva", "copiarDelAnterior": true,
        "valores": ["sin_cupula", "sin_cupula_iluminacion", "cupula_curva", "cupula_recta"],
        "soloSi": { "version": "frio" },
        "motivo": "La esquina mostrador no lleva exhibición: es una tapa de inox." },
      { "id": "puertasTraseras", "tipo": "bool", "default": false,
        "soloSi": { "version": "frio", "cupula": ["cupula_curva", "cupula_recta"] },
        "motivo": "Las puertas traseras de acrílico solo van en esquinas con frío y cúpula (curva o recta)." }
    ],
    "remate": [
      { "id": "valor", "tipo": "select", "default": "ninguno", "valores": ["ninguno", "mostrador"] }
    ]
  },
  "paletas": {
