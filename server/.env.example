# server/.env: lo lee dotenv al correr el server local (npm run dev / npm start / npm run migrar).
# En Docker y Dokploy las variables vienen de docker-compose.yml (ver ../.env.example).
PORT=3001

# MySQL local (contenedor cll-mysql en localhost:3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

CORS_ORIGIN=http://localhost:5173

# Pedidos de presupuesto (ver ../.env.example para el detalle de cada una)
MAIL_PROVEEDOR=prueba
MAIL_VENTAS=
MAIL_REMITENTE=
MAIL_TIEMPO_RESPUESTA=48 horas hábiles
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Si no se definen: server/tmp/capturas y server/tmp/mails
# CAPTURAS_DIR=
# MAIL_CARPETA_PRUEBA=
