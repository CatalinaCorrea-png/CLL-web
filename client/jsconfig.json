{
  // Chequeo de tipos con JSDoc SOLO en el configurador 3D (src/configurador/).
  // Los archivos siguen siendo .js/.jsx: no hay compilación y el build de Vite no cambia.
  // VS Code marca los errores al escribir; `npm run tipos` los revisa por consola.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/configurador/**/*"],
  // Los tests corren en Node (node:test) y se verifican ejecutándolos con `npm test`.
  "exclude": ["src/configurador/**/*.test.js"]
}
