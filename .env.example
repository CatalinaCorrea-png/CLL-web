# .env de la RAÍZ: lo lee Docker Compose para completar ${VARIABLE} en docker-compose.yml.
# Copiar a .env (no se versiona) o cargar las mismas variables en Dokploy (Environment del proyecto).
# Para correr el server suelto con npm run dev, ver server/.env.example.

# --- Base de datos (MySQL 8, servicio db) ---
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- App ---
# Orígenes que pueden llamar a la API, separados por coma (sin barra final)
CORS_ORIGIN=https://cllheladeras.cloud,https://www.cllheladeras.cloud
# URL pública de la API, la usa el build del client
VITE_API_URL=

# --- Pedidos de presupuesto: mails ---
# prueba: NO manda nada; deja cada mail como .eml/.html en el volumen mails_prueba (para revisar)
# smtp:   Gmail (u otro SMTP) con contraseña de aplicación
# resend: API de Resend (resend.com)
MAIL_PROVEEDOR=prueba
# Quién recibe los pedidos en CLL
MAIL_VENTAS=
# Remitente. Con Gmail tiene que ser la misma cuenta de SMTP_USER (si se deja vacío, se usa esa).
# Con Resend, una dirección del dominio verificado (p. ej. CLL Heladeras <presupuestos@cllheladeras.cloud>)
MAIL_REMITENTE=
# Texto del mail al cliente: "Te respondemos en ..."  (PROVISORIO: lo confirma CLL)
MAIL_TIEMPO_RESPUESTA=48 horas hábiles

# Solo con MAIL_PROVEEDOR=smtp (Gmail: smtp.gmail.com, 465, la cuenta y una contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Solo con MAIL_PROVEEDOR=resend
RESEND_API_KEY=
